# Ollama на хосте (Windows / macOS / Linux с host-gateway)
OLLAMA_BASE_URL=http://host.docker.internal:11434

# Порт API на хосте (локальная разработка: 8021)
API_HOST_PORT=8020

# Модели Ollama (должны быть скачаны: ollama pull qwen3.8:27b)
ANALYST_MODEL=qwen3.8:27b
CODER_MODEL=qwen3-coder:latest

# Origins UI (через запятую)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
